# Solana mainnet RPC. Used to read Pyth price accounts, token mints, balances
# and to send transactions. The public endpoint works for testing but is
# rate-limited; a free Helius/Triton/QuickNode URL is much more reliable.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Optional: Jupiter API. Defaults to the free lite-api.
# JUPITER_API_URL=https://api.jup.ag/swap/v1
# JUPITER_API_KEY=
