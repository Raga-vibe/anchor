# Pyth Pro API key: free from a Pyth Terminal account ("View your API key").
# Server-side only. Never prefix with NEXT_PUBLIC_.
PYTH_PRO_API_KEY=

# Solana mainnet RPC. The public endpoint works for testing but is rate-limited;
# a free Helius/Triton/QuickNode URL is more reliable for the demo.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Optional: Jupiter API. Defaults to the free lite-api.
# JUPITER_API_URL=https://api.jup.ag/swap/v1
# JUPITER_API_KEY=
